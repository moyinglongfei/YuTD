// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 任务
model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  completed Boolean @default(false)

  priority Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dueDate     DateTime? //截止日期
  plannedDate DateTime? //计划日期(预计扩充成多日期)

  estimatedTime Int? //预计花费时间
  actualTime    Int? //实际花费时间

  reminders TaskReminder[]
  tags      TaskTag[]
  tips      Tip[]

  phaseId Int
  phase   Phase @relation(fields: [phaseId], references: [id], onDelete: Restrict)

  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  status TaskStatus @default(TODO)
}

model TaskReminder {
  id     Int      @id @default(autoincrement())
  time   DateTime
  taskId Int
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, time])
  @@index([time])
}

model TaskTag {
  id     Int    @id @default(autoincrement())
  name   String
  taskId Int
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, name])
  @@index([name])
}

enum TaskStatus {
  TODO
  DOING
  DONE
  CANCELLED
}

// 阶段
model Phase {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]
  tasks     Task[]
  tips      Tip[]
}

// 事件
model Event {
  id        Int             @id @default(autoincrement())
  name      String
  organizer String?
  location  String?
  color     String?
  phaseId   Int
  phase     Phase           @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  schedules EventSchedule[]
  tasks     Task[]
  tips      Tip[]
}

// 提示
model Tip {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) // 仅在内容变化时由服务更新
  dates     TipDate[]
  events    Event[]
  phases    Phase[]
  tasks     Task[]
}

model TipDate {
  id    Int    @id @default(autoincrement())
  date  String // YYYY-MM-DD，不进行时区转换
  tipId Int
  tip   Tip    @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([tipId, date])
  @@index([date])
}

// 事件日程
model EventSchedule {
  id        Int     @id @default(autoincrement())
  eventId   Int
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  weeks     Json
  location  String?
}

model Style {
  id                      Int      @id @default(autoincrement())
  defaultLocale           String   @default("zh-CN")
  scheduleBackground      String   @default("#f4efe7")
  schedulePanelBackground String   @default("rgba(255,255,255,0.82)")
  scheduleGridLineColor   String   @default("rgba(226,232,240,0.9)")
  scheduleSlotHeight      Int      @default(72)
  scheduleSlotGap         Int      @default(8)
  presetName              String   @default("campus")
  coursePalette           String   @default("[\"#0f766e\",\"#1d4ed8\",\"#be123c\",\"#7c3aed\"]")
  schedulePageClass       String   @default("")
  scheduleBoardClass      String   @default("")
  scheduleCardClass       String   @default("")
  customCss               String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

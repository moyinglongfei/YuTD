// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ServerInfo {
  id        Int      @id @default(1)
  version   BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Image {
  id              String   @id @default(uuid())
  name            String
  mimeType        String
  extension       String
  size            Int
  originalSize    Int?
  thumbnailSize   Int?
  thumbnailWidth  Int?
  thumbnailHeight Int?
  width           Int
  height          Int
  createdAt       DateTime @default(now())
  queuePosition   Int?
  randomEnabled   Boolean  @default(true)
  backgrounds     ImageBackground[]

  @@index([createdAt, id])
  @@index([queuePosition])
}

model ImageBackground {
  backgroundKey String @id
  imageId       String
  image         Image @relation(fields: [imageId], references: [id], onDelete: Cascade)
  position      Json?

  @@index([imageId])
}

// 任务
model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  completed Boolean @default(false)
  completedAt DateTime? //完成或放弃的时间，重新打开后清空

  priority Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dueDate     DateTime? //截止日期
  plannedDate DateTime? //计划日期

  estimatedTime Int? //预计花费时间
  actualTime    Int? //实际花费时间

  reminders TaskReminder[]
  tags      TaskTag[]
  tips      Tip[]

  phaseId Int
  phase   Phase @relation(fields: [phaseId], references: [id], onDelete: Restrict)

  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  status TaskStatus @default(TODO)

  @@index([completedAt])
}

model TaskReminder {
  id     Int      @id @default(autoincrement())
  time   DateTime
  taskId Int
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, time])
  @@index([time])
}

model TaskTag {
  id     Int    @id @default(autoincrement())
  name   String
  taskId Int
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, name])
  @@index([name])
}

enum TaskStatus {
  TODO
  DOING
  DONE
  CANCELLED
}

// 阶段
model Phase {
  id          Int      @id @default(autoincrement())
  name        String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      Event[]
  tasks       Task[]
  tips        Tip[]
  dates       Date[]
  weeks       Week[]
  preferences Preferences[]
}

// 事件
model Event {
  id        Int             @id @default(autoincrement())
  name      String
  organizer String?         //默认事件组织者
  location  String?         //默认事件地点
  color     String?
  phaseId   Int
  phase     Phase           @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  schedules EventSchedule[]
  tasks     Task[]
  tips      Tip[]
}

// 提示
model Tip {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) // 仅在内容变化时由服务更新
  dates     Date[]    @relation("TipDates")
  weeks     Week[]    @relation("TipWeeks")
  events    Event[]
  phases    Phase[]
  tasks     Task[]
}

model Date {
  id        String @id // phaseId（或 all）:YYYY-MM-DD
  date      String // YYYY-MM-DD，不进行时区转换
  taskState Int    @default(0) // 0 显示任务，1 已清空
  phaseId   Int?
  phase     Phase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  tips      Tip[]  @relation("TipDates")

  @@index([date, phaseId])
}

model Week {
  id         String @id // phaseId（或 all）:周一日期
  date       String // 周一的 YYYY-MM-DD
  taskState  Int    @default(0)
  weekNumber Int? // 所属 Phase 的第几周；无 Phase 的共享周留空
  phaseId    Int?
  phase      Phase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  tips       Tip[]  @relation("TipWeeks")

  @@index([date, phaseId])
  @@unique([phaseId, weekNumber])
}

// 事件日程
model EventSchedule {
  id        Int     @id @default(autoincrement())
  eventId   Int
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  weeks     Json
  organizer String?         //此次事件日程组织者，留空使用默认
  location  String?         //此次事件日程地点，留空使用默认
}

// 界面风格
model Style {
  id                      Int      @id @default(autoincrement())
  name                    String   @default("我的样式")
  showMode                Int      @default(1) // 0 简洁，1 华丽
  backgroundPrimary       String   @default("#f5f7fb")
  backgroundSecondary     String   @default("#ffffff")
  textPrimary             String   @default("#172033")
  textSecondary           String   @default("#64748b")
  fontFamily              String   @default("system-ui")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  preferences             Preferences[]
}

// 偏好设置
model Preferences{
  id                      Int      @id @default(autoincrement())
  defaultLocale           String   @default("zh-CN")
  defaultPhaseId          Int?      //用户进入界面的默认阶段ID
  activeStyleId           Int?
  sidebarWidth            Int      @default(64)
  maxFocusScale           Float    @default(2)
  focusColumnScale        Float    @default(3)
  hourPixels              Int      @default(72)
  edgePixels              Int      @default(20)
  timeZone                String?
  timeZoneAutomatic       Boolean  @default(true)
  defaultPhase            Phase?   @relation(fields: [defaultPhaseId],references: [id],onDelete: SetNull)
  activeStyle             Style?   @relation(fields: [activeStyleId],references: [id],onDelete: SetNull)
}

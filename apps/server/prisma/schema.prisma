// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 任务
model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  completed Boolean @default(false)

  priority Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dueDate     DateTime? //截止日期
  plannedDate DateTime? //计划日期(预计扩充成多日期)

  estimatedTime Int? //预计花费时间
  actualTime    Int? //实际花费时间

  reminders TaskReminder[]
  tags      TaskTag[]
  tips      Tip[]

  phaseId Int
  phase   Phase @relation(fields: [phaseId], references: [id], onDelete: Restrict)

  eventId Int?
  event   Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  status TaskStatus @default(TODO)
}

model TaskReminder {
  id     Int      @id @default(autoincrement())
  time   DateTime
  taskId Int
  task   Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, time])
  @@index([time])
}

model TaskTag {
  id     Int    @id @default(autoincrement())
  name   String
  taskId Int
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, name])
  @@index([name])
}

enum TaskStatus {
  TODO
  DOING
  DONE
  CANCELLED
}

// 阶段
model Phase {
  id          Int      @id @default(autoincrement())
  name        String
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  events      Event[]
  tasks       Task[]
  tips        Tip[]
  preferences Preferences[]
}

// 事件
model Event {
  id        Int             @id @default(autoincrement())
  name      String
  organizer String?         //默认事件组织者
  location  String?         //默认事件地点
  color     String?
  phaseId   Int
  phase     Phase           @relation(fields: [phaseId], references: [id], onDelete: Restrict)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  schedules EventSchedule[]
  tasks     Task[]
  tips      Tip[]
}

// 提示
model Tip {
  id        Int       @id @default(autoincrement())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) // 仅在内容变化时由服务更新
  dates     TipDate[]
  events    Event[]
  phases    Phase[]
  tasks     Task[]
}

model TipDate {
  id    Int    @id @default(autoincrement())
  date  String // YYYY-MM-DD，不进行时区转换
  tipId Int
  tip   Tip    @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([tipId, date])
  @@index([date])
}

// 事件日程
model EventSchedule {
  id        Int     @id @default(autoincrement())
  eventId   Int
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  weeks     Json
  organizer String?         //此次事件日程组织者，留空使用默认
  location  String?         //此次事件日程地点，留空使用默认
}

// 界面风格
model Style {
  id                      Int      @id @default(autoincrement())
  name                    String   @default("我的样式")
  defaultLocale           String   @default("zh-CN")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  preferences             Preferences[]
}

// 偏好设置
model Preferences{
  id                      Int      @id @default(autoincrement())
  defaultPhaseId          Int?      //用户进入界面的默认阶段ID
  activeStyleId           Int?
  defaultPhase            Phase?   @relation(fields: [defaultPhaseId],references: [id],onDelete: SetNull)
  activeStyle             Style?   @relation(fields: [activeStyleId],references: [id],onDelete: SetNull)
}

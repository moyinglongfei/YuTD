{
  "name": "@yutd/server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts --dev",
    "start": "bun src/index.ts",
    "build:binary": "bun run prisma:generate && bun build.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate && prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output generated/prisma/initialize.sql"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@elysia/static": "^1.4.12",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.15",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sinclair/typebox": "0.34.48",
    "dotenv": "^17.3.1",
    "elysia": "^1.4.30",
    "elysia-http-exception": "^0.1.5",
    "logixlysia": "^6.8.0",
    "prisma": "^7.10.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "5.9.3"
  }
}

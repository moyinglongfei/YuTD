{
  "name": "YuTD",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "bun --filter @yutd/server prisma:generate",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "build:binary": "bun run build && bun --filter @yutd/server build:binary",
    "start": "bun --filter @yutd/server start",
    "web": "bun --filter @yutd/web dev",
    "server": "bun --filter @yutd/server dev",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1"
  },
  "devDependencies": {
    "bun-tasks": "^0.1.4",
    "vitepress": "^2.0.0-alpha.21"
  }
}